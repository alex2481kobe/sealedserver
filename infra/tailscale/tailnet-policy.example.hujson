{
  // Tailnet policy for servers. Admins reach tagged servers on SSH only.
  "tagOwners": {
    "tag:server": ["autogroup:admin"],
    "tag:prod": ["autogroup:admin"],
    "tag:dev": ["autogroup:admin"]
  },

  "acls": [
    {
      "action": "accept",
      "src": ["autogroup:admin"],
      "dst": ["tag:server:22", "tag:prod:22", "tag:dev:22"]
    }
  ],

  // Only for servers started with `tailscale up --ssh`. OpenSSH over
  // Tailscale ignores this block.
  // "ssh": [
  //   {
  //     "action": "check",
  //     "src": ["autogroup:admin"],
  //     "dst": ["tag:prod"],
  //     "users": ["deploy"],
  //     "checkPeriod": "always"
  //   },
  //   {
  //     "action": "check",
  //     "src": ["autogroup:admin"],
  //     "dst": ["tag:server", "tag:dev"],
  //     "users": ["deploy"],
  //     "checkPeriod": "1h"
  //   }
  // ],

  "tests": [
    {
      "src": "autogroup:admin",
      "accept": ["tag:server:22", "tag:prod:22", "tag:dev:22"],
      "deny": ["tag:prod:8080"]
    }
  ]
}
