# Litestream replication for one app, running as the app's user so SQLite
# sidecar files keep the app's ownership.
#
# Install to /etc/systemd/system/litestream-example.service and replace example.

[Unit]
Description=Litestream for example
After=network-online.target
Wants=network-online.target

[Service]
User=example
Group=example
ExecStart=/usr/bin/litestream replicate -config /etc/example/litestream.yml
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
