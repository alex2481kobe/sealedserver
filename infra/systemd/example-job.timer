# Example systemd timer.
#
# Copy to /etc/systemd/system/example-job.timer and enable with:
# sudo systemctl enable --now example-job.timer

[Unit]
Description=Run Example Scheduled Job Every 15 Minutes

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true
Unit=example-job.service

[Install]
WantedBy=timers.target
